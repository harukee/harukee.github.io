---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Mermaid from '../components/Mermaid.astro';

interface Props {
	title: string;
	description: string;
	date?: Date;
	updatedDate?: Date;
	categories?: string[];
	tags?: string[];
	draft?: boolean;
}

const { title, description, date, updatedDate, categories = [], tags = [], draft = false } =
	Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		{draft && <meta name="robots" content="noindex" />}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.categories a {
				margin: 0 0.25em;
				font-size: 0.8em;
				font-weight: 700;
				text-decoration: none;
			}
			.tags {
				margin-top: 3em;
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						{
							date && (
								<div class="date">
									<FormattedDate date={date} />
									{updatedDate && (
										<div class="last-updated-on">
											수정 <FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)
						}
						<h1>{title}</h1>
						{
							categories.length > 0 && (
								<div class="categories">
									{categories.map((c) => (
										<a href={`/category/${c.toLowerCase()}`}>{c}</a>
									))}
								</div>
							)
						}
						<hr />
					</div>
					<slot />
					{tags.length > 0 && <p class="tags">{tags.map((t) => `#${t}`).join(' ')}</p>}
				</div>
			</article>
		</main>
		<Footer />
		<Mermaid />
	</body>
</html>
