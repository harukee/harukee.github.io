---
import type { Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 글이 없습니다.</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<h3 class="title">
							{post.data.draft && <span class="draft">초안</span>}
							{post.data.title}
						</h3>
						<p class="meta">
							<FormattedDate date={post.data.date} />
							<span aria-hidden="true"> · </span>
							{post.data.categories.join(' / ')}
						</p>
						<p class="desc">{post.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		margin-bottom: 2rem;
	}
	.post-list a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.title {
		margin: 0 0 0.25rem;
		font-size: 1.4em;
		line-height: 1.3;
		color: rgb(var(--black));
	}
	.post-list a:hover .title {
		color: var(--accent);
	}
	.meta {
		margin: 0 0 0.25rem;
		font-size: 0.75em;
		color: rgb(var(--gray));
	}
	.desc {
		margin: 0;
		font-size: 0.85em;
	}
	.draft {
		margin-right: 0.5em;
		padding: 0.1em 0.5em;
		border-radius: 4px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray));
		font-size: 0.55em;
		vertical-align: middle;
	}
	.empty {
		color: rgb(var(--gray));
	}
</style>
